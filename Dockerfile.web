### ---------- Stage 1: builder (frontend only) ----------
FROM node:22-alpine AS builder

RUN apk add --no-cache python3 make g++ libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY pnpm-workspace.yaml package.json tsconfig.json tsconfig.base.json* ./
COPY .npmrc* ./

COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/lotus-crm/package.json   ./artifacts/lotus-crm/
COPY artifacts/mockup-sandbox/package.json ./artifacts/mockup-sandbox/
COPY lib/db/package.json                 ./lib/db/
COPY lib/api-spec/package.json           ./lib/api-spec/
COPY lib/api-zod/package.json            ./lib/api-zod/
COPY lib/api-client-react/package.json   ./lib/api-client-react/
COPY scripts/package.json                ./scripts/

RUN pnpm install --no-frozen-lockfile

COPY . .

ENV PORT=8080
ENV BASE_PATH=/
RUN pnpm --filter @workspace/lotus-crm run build


### ---------- Stage 2: nginx serving static frontend ----------
FROM nginx:1.27-alpine AS web

# Replace the default config with ours
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Frontend static files
COPY --from=builder /app/artifacts/lotus-crm/dist/public /usr/share/nginx/html

EXPOSE 80
